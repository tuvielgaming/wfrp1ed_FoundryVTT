<section
	class="wfrp1ed-pending-standard-test"
	data-wfrp-pending-standard-test
>
	<header class="pending-standard-test-header">
		<h3>{{testName}}</h3>
		<div class="pending-standard-test-actor">{{actorName}}</div>
	</header>

	<div class="pending-standard-test-target-status">
		<strong>{{targetLabel}}:</strong>
		<span>{{pendingLabel}}</span>
	</div>

	<div
		class="pending-standard-test-gm-controls"
		data-pending-standard-controls
		hidden
	>
		<label class="pending-standard-test-scene-target">
			<span>{{targetLabel}}</span>
			<select data-pending-standard-scene-target></select>
		</label>

		<div
			class="pending-standard-test-manual"
			data-pending-standard-manual
		>
			{{#each manualInputs}}
				<label class="pending-standard-test-manual-field">
					<span>{{label}}</span>
					<input
						type="number"
						step="1"
						autocomplete="off"
						value="{{value}}"
						data-pending-standard-manual-value
						data-characteristic-id="{{id}}"
					>
				</label>
			{{/each}}
		</div>

		<div
			class="pending-standard-test-gm-only"
			data-pending-standard-gm-only
			hidden
		>
			<div
				class="pending-standard-test-drop"
				data-pending-standard-target-drop
				tabindex="0"
			>
				<i class="fa-solid fa-arrow-down-to-bracket" aria-hidden="true"></i>
				<span>{{dropPrompt}}</span>
			</div>

			<button
				type="button"
				data-pending-standard-action="choose-actor"
			>
				<i class="fa-solid fa-user" aria-hidden="true"></i>
				{{chooseActorLabel}}
			</button>
		</div>

		<button
			type="button"
			class="pending-standard-test-roll"
			data-pending-standard-action="roll"
			data-target-resolved="{{targetResolved}}"
		>
			<i class="fa-solid fa-dice-d100" aria-hidden="true"></i>
			{{rollLabel}}
		</button>
	</div>

	<p
		class="pending-standard-test-waiting"
		data-pending-standard-player-status
	>
		{{waitingLabel}}
	</p>
</section>
