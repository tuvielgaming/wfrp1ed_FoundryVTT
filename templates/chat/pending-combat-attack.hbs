<section
	class="wfrp1ed-pending-combat-attack"
	data-wfrp-pending-combat-attack
>
	<header class="pending-combat-attack__header">
		<div>
			<h3>{{title}}</h3>
			<div class="pending-combat-attack__weapon">{{weaponName}}</div>
		</div>
		<div class="pending-combat-attack__actor">{{actorName}}</div>
	</header>

	<div class="pending-combat-attack__target-status">
		<strong>{{targetLabel}}:</strong>
		<span>{{pendingLabel}}</span>
	</div>

	<div
		class="pending-combat-attack__gm-controls"
		data-pending-attack-gm-controls
		hidden
	>
		<div
			class="pending-combat-attack__drop"
			data-pending-attack-drop
			tabindex="0"
		>
			<i class="fa-solid fa-arrow-down-to-bracket" aria-hidden="true"></i>
			<span>{{dropPrompt}}</span>
		</div>

		<div class="pending-combat-attack__actions">
			<button
				type="button"
				data-pending-attack-action="current-target"
			>
				<i class="fa-solid fa-bullseye" aria-hidden="true"></i>
				{{useCurrentTargetLabel}}
			</button>

			<button
				type="button"
				data-pending-attack-action="choose-actor"
			>
				<i class="fa-solid fa-user" aria-hidden="true"></i>
				{{chooseActorLabel}}
			</button>

			<button
				type="button"
				class="pending-combat-attack__no-defender"
				data-pending-attack-action="no-defender"
			>
				<i class="fa-solid fa-door-closed" aria-hidden="true"></i>
				{{noDefenderLabel}}
			</button>
		</div>
	</div>

	<p
		class="pending-combat-attack__waiting"
		data-pending-attack-player-status
	>
		{{waitingGmLabel}}
	</p>
</section>
