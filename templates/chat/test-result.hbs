<div class="wfrp1e-test-card">
	<header>
		<h2>{{result.test.name}}</h2>
	</header>

	<table>
		<tr>
			<td>{{localize "WFRP1ED.TestResult.Target"}}</td>
			<td>{{result.target}}</td>
		</tr>

		<tr>
			<td>{{localize "WFRP1ED.TestResult.Roll"}}</td>
			<td>{{result.roll}}</td>
		</tr>

		<tr>
			<td>{{localize "WFRP1ED.TestResult.Result"}}</td>
			<td>
				{{#if result.success}}
					{{localize "WFRP1ED.TestResult.Success"}}
				{{else}}
					{{localize "WFRP1ED.TestResult.Failure"}}
				{{/if}}
			</td>
		</tr>

		<tr>
			<td>{{localize "WFRP1ED.TestResult.Margin"}}</td>
			<td>{{result.margin}}</td>
		</tr>
	</table>
</div>