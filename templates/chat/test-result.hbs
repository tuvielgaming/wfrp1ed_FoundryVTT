<article class="wfrp1e-test-card {{#if result.success}}is-success{{else}}is-failure{{/if}}">
	<header class="wfrp1e-test-card__header">
		<h2>{{result.test.name}}</h2>
		<span class="wfrp1e-test-card__status">
			{{#if result.success}}
				{{localize "WFRP1ED.TestResult.Success"}}
			{{else}}
				{{localize "WFRP1ED.TestResult.Failure"}}
			{{/if}}
		</span>
	</header>

	<details class="wfrp1e-test-card__target">
		<summary title="{{breakdown.expandHint}}">
			<span class="wfrp1e-test-card__target-label">
				{{localize "WFRP1ED.TestResult.Target"}}
			</span>
			<strong class="wfrp1e-test-card__target-value">
				{{wfrpTargetDisplay result.target breakdown.characteristic breakdown.variables}}
			</strong>
			<span class="wfrp1e-test-card__target-toggle" aria-hidden="true">⌄</span>
		</summary>

		<div class="wfrp1e-test-card__breakdown">
			{{#if breakdown.characteristic}}
				<section class="wfrp1e-test-card__breakdown-section">
					<div class="wfrp1e-test-card__section-title">
						{{breakdown.baseTargetLabel}}
					</div>
					<div class="wfrp1e-test-card__breakdown-row">
						<span>{{breakdown.characteristic.label}}</span>
						<strong>{{breakdown.characteristic.value}}</strong>
					</div>
				</section>
			{{/if}}

			{{#if breakdown.formula}}
				<section class="wfrp1e-test-card__breakdown-section">
					<div data-wfrp-gm-only>
						<div class="wfrp1e-test-card__section-title">
							{{breakdown.formulaLabel}}
						</div>
						<code class="wfrp1e-test-card__formula">{{breakdown.formula}}</code>
					</div>

					{{#if breakdown.variables}}
						<div class="wfrp1e-test-card__section-subtitle">
							{{breakdown.inputsLabel}}
						</div>
						<div class="wfrp1e-test-card__breakdown-rows">
							{{#each breakdown.variables}}
								{{#if (wfrpIsTargetVariable key)}}
									<div class="wfrp1e-test-card__breakdown-row" data-wfrp-gm-only>
										<span>{{label}}</span>
										<strong>{{value}}</strong>
									</div>
								{{else}}
									<div class="wfrp1e-test-card__breakdown-row">
										<span>{{label}}</span>
										<strong>{{value}}</strong>
									</div>
								{{/if}}
							{{/each}}
						</div>
					{{/if}}

					<div class="wfrp1e-test-card__breakdown-row is-subtotal">
						<span>{{breakdown.baseTargetLabel}}</span>
						<strong>{{wfrpTargetDisplay breakdown.baseTarget breakdown.characteristic breakdown.variables}}</strong>
					</div>
				</section>
			{{/if}}

			<section class="wfrp1e-test-card__breakdown-section">
				<div class="wfrp1e-test-card__section-title">
					{{breakdown.modifiersLabel}}
				</div>
				<div class="wfrp1e-test-card__breakdown-rows">
					{{#if breakdown.generalModifier}}
						<div class="wfrp1e-test-card__breakdown-row is-general-modifier">
							<span>{{breakdown.generalModifier.source}}</span>
							<input
								class="wfrp1e-test-card__modifier-input"
								data-wfrp-test-general-modifier
								type="number"
								step="1"
								value="{{breakdown.generalModifier.value}}"
								autocomplete="off"
							/>
						</div>
					{{/if}}

					{{#each breakdown.modifiers}}
						<div
							class="wfrp1e-test-card__breakdown-row {{#unless enabled}}is-disabled{{/unless}}"
							data-wfrp-test-modifier-row
							data-modifier-index="{{@index}}"
							data-modifier-type="{{type}}"
						>
							<span class="wfrp1e-test-card__modifier-source">
								<label class="wfrp1ed-checkbox wfrp1e-test-card__effect-toggle">
									<input
										type="checkbox"
										data-wfrp-test-modifier-toggle
										data-modifier-index="{{@index}}"
										data-modifier-type="{{type}}"
										aria-label="{{source}}"
										{{#if enabled}}checked{{/if}}
										disabled
									/>
								</label>
								<span>{{source}}</span>
								{{#unless enabled}}
									<em>({{../breakdown.disabledLabel}})</em>
								{{/unless}}
							</span>
							<strong>{{signed}}</strong>
						</div>
					{{/each}}
				</div>
			</section>

			<div class="wfrp1e-test-card__breakdown-summary">
				<div class="wfrp1e-test-card__breakdown-row">
					<span>{{breakdown.totalModifierLabel}}</span>
					<strong>{{breakdown.totalModifierSigned}}</strong>
				</div>
				<div class="wfrp1e-test-card__breakdown-row is-final">
					<span>{{breakdown.finalTargetLabel}}</span>
					<strong>{{wfrpTargetDisplay breakdown.finalTarget breakdown.characteristic breakdown.variables}}</strong>
				</div>
			</div>
		</div>
	</details>

	<div class="wfrp1e-test-card__metrics">
		<div class="wfrp1e-test-card__metric">
			<span>{{localize "WFRP1ED.TestResult.Roll"}}</span>
			<strong>{{result.roll}} vs {{wfrpTargetDisplay result.target breakdown.characteristic breakdown.variables}}</strong>
		</div>
		<div class="wfrp1e-test-card__metric">
			<span>{{localize "WFRP1ED.TestResult.Margin"}}</span>
			<strong>{{result.margin}}</strong>
		</div>
	</div>
</article>