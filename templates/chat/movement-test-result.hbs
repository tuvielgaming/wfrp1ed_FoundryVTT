<article class="wfrp1e-test-card {{#unless neutral}}{{#if success}}is-success{{else}}is-failure{{/if}}{{/unless}}">
  <header class="wfrp1e-test-card__header">
    <h2>{{procedureName}}</h2>
    <span class="wfrp1e-test-card__status">{{statusLabel}}</span>
  </header>

  <details class="wfrp1e-test-card__target">
    <summary title="{{detailsHint}}">
      <span class="wfrp1e-test-card__target-label">{{primaryLabel}}</span>
      <strong class="wfrp1e-test-card__target-value">{{primaryValue}}</strong>
      <span class="wfrp1e-test-card__target-toggle" aria-hidden="true">⌄</span>
    </summary>

    <div class="wfrp1e-test-card__breakdown">
      <section class="wfrp1e-test-card__breakdown-section">
        <div class="wfrp1e-test-card__section-title">{{fullRoundLabel}}</div>
        <div class="wfrp1e-test-card__breakdown-rows">
          {{#each rows}}
            <div class="wfrp1e-test-card__breakdown-row">
              <span>{{label}}</span>
              <strong>{{value}}</strong>
            </div>
          {{/each}}
        </div>
      </section>

      {{#if note}}
        <section class="wfrp1e-test-card__breakdown-section">
          <div class="wfrp1e-test-card__section-subtitle">{{note}}</div>
          {{#if secondaryNote}}
            <div class="wfrp1e-test-card__section-subtitle">{{secondaryNote}}</div>
          {{/if}}
        </section>
      {{/if}}
    </div>
  </details>

  {{#if showHeldItemsAction}}
    <div class="wfrp1e-movement-consequence">
      <button
        type="button"
        class="wfrp1e-movement-consequence__action"
        data-wfrp-held-items-roll
      >{{heldItemsActionLabel}}</button>
    </div>
  {{/if}}

  {{#if heldItemsPhaseLabel}}
    <div
      class="wfrp1e-movement-consequence__status"
      data-wfrp-held-items-phase
    >{{heldItemsPhaseLabel}}</div>
  {{/if}}

  <div class="wfrp1e-test-card__metrics">
    <div class="wfrp1e-test-card__metric">
      <span>{{metricLeftLabel}}</span>
      <strong>{{metricLeftValue}}</strong>
    </div>
    <div class="wfrp1e-test-card__metric">
      <span>{{metricRightLabel}}</span>
      <strong>{{metricRightValue}}</strong>
    </div>
  </div>
</article>
