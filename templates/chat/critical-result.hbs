<section class="wfrp1e-critical-result wfrp1e-critical-result--standalone {{outcomeClass}}" data-wfrp-critical-card>
	<div class="wfrp1e-critical-result__header">
		<strong>{{title}}</strong>
	</div>

	<div class="wfrp1e-critical-result__meta">
		{{rollLabel}}: {{rollTotal}}
	</div>

	<div class="wfrp1e-critical-result__outcome">
		{{outcomeLabel}}
	</div>
</section>
