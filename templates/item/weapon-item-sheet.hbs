<div class="weapon-item-sheet__root">
	<header class="combat-item-sheet__header weapon-item-sheet__header wfrp1ed-item-header">
		<img class="combat-item-sheet__image wfrp1ed-item-header__image" data-wfrp1ed-item-image src="{{item.img}}" alt="{{item.name}}">
		<label class="combat-item-sheet__field combat-item-sheet__field--name">
			<span>{{ui.name}}</span>
			<input type="text" name="name" value="{{item.name}}" autocomplete="off" required {{#unless editable}}disabled{{/unless}}>
		</label>
	</header>

	<nav class="weapon-item-sheet__tabs wfrp1ed-tabs" role="tablist" aria-label="{{ui.name}}">
		<button type="button" class="wfrp1ed-tab" role="tab" data-action="showDetails" data-weapon-tab-button="details">
			<i class="fa-solid fa-list"></i>
			<span>{{ui.detailsTab}}</span>
		</button>
		<button type="button" class="wfrp1ed-tab" role="tab" data-action="showEffects" data-weapon-tab-button="effects">
			<i class="fa-solid fa-wand-magic-sparkles"></i>
			<span>{{ui.effectsTab}}</span>
		</button>
	</nav>

	<div class="weapon-item-sheet__tab-content">
		<section class="combat-item-sheet__content" data-weapon-tab-panel="details">

	<section class="combat-item-sheet__panel">
		<h3>{{ui.inventory}}</h3>
		<div class="combat-item-sheet__grid combat-item-sheet__grid--4">
			<label class="combat-item-sheet__field">
				<span>{{ui.mode}}</span>
				<select name="system.state.mode" {{#unless editable}}disabled{{/unless}}>
					{{#each modeOptions as |option|}}<option value="{{option.value}}" {{#if option.selected}}selected{{/if}}>{{option.label}}</option>{{/each}}
				</select>
			</label>
			<label class="combat-item-sheet__field">
				<span>{{ui.hand}}</span>
				<select name="system.state.hand" {{#unless editable}}disabled{{/unless}}>
					{{#each handOptions as |option|}}<option value="{{option.value}}" {{#if option.selected}}selected{{/if}}>{{option.label}}</option>{{/each}}
				</select>
			</label>
			<label class="combat-item-sheet__field"><span>{{ui.quantity}}</span><input type="number" min="0" step="1" name="system.quantity" value="{{system.quantity}}" {{#unless editable}}disabled{{/unless}}></label>
			<label class="combat-item-sheet__field"><span>{{ui.encumbrance}}</span><input type="number" min="0" step="any" name="system.encumbrance" value="{{system.encumbrance}}" {{#unless editable}}disabled{{/unless}}></label>
		</div>
		<label class="combat-item-sheet__field"><span>{{ui.availability}}</span><input type="text" name="system.availability" value="{{system.availability}}" autocomplete="off" {{#unless editable}}disabled{{/unless}}></label>
	</section>

	<section class="combat-item-sheet__panel">
		<h3>{{ui.price}}</h3>
		<div class="combat-item-sheet__grid combat-item-sheet__grid--3">
			<label class="combat-item-sheet__field equipment-item-sheet__currency-field"><span class="equipment-item-sheet__currency-label equipment-item-sheet__currency-label--gold">{{ui.gc}}</span><input type="number" min="0" step="1" name="system.price.gc" value="{{system.price.gc}}" {{#unless editable}}disabled{{/unless}}></label>
			<label class="combat-item-sheet__field equipment-item-sheet__currency-field"><span class="equipment-item-sheet__currency-label equipment-item-sheet__currency-label--silver">{{ui.ss}}</span><input type="number" min="0" step="1" name="system.price.ss" value="{{system.price.ss}}" {{#unless editable}}disabled{{/unless}}></label>
			<label class="combat-item-sheet__field equipment-item-sheet__currency-field"><span class="equipment-item-sheet__currency-label equipment-item-sheet__currency-label--copper">{{ui.bp}}</span><input type="number" min="0" step="1" name="system.price.bp" value="{{system.price.bp}}" {{#unless editable}}disabled{{/unless}}></label>
		</div>
		<label class="combat-item-sheet__field"><span>{{ui.priceFormula}}</span><input type="text" name="system.priceFormula" value="{{system.priceFormula}}" autocomplete="off" placeholder="{{ui.priceFormulaHint}}" {{#unless editable}}disabled{{/unless}}></label>
	</section>

	<section class="combat-item-sheet__panel">
		<h3>{{ui.combat}}</h3>
		<div class="combat-item-sheet__grid combat-item-sheet__grid--2">
			<label class="combat-item-sheet__field"><span>{{ui.rulesId}}</span><input type="text" name="system.rulesId" value="{{system.rulesId}}" autocomplete="off" {{#unless editable}}disabled{{/unless}}></label>
			<label class="combat-item-sheet__field"><span>{{ui.weaponClass}}</span><input type="text" name="system.weaponClass" value="{{system.weaponClass}}" autocomplete="off" {{#unless editable}}disabled{{/unless}}></label>
			<label class="combat-item-sheet__field">
				<span>{{ui.kind}}</span>
				<select name="system.kind" {{#unless editable}}disabled{{/unless}}>{{#each kindOptions as |option|}}<option value="{{option.value}}" {{#if option.selected}}selected{{/if}}>{{option.label}}</option>{{/each}}</select>
			</label>
			<label class="combat-item-sheet__field">
				<span>{{ui.group}}</span>
				<select name="system.group" {{#unless editable}}disabled{{/unless}}>{{#each groupOptions as |option|}}<option value="{{option.value}}" {{#if option.selected}}selected{{/if}}>{{option.label}}</option>{{/each}}</select>
			</label>
			<label class="combat-item-sheet__field">
				<span>{{ui.handedness}}</span>
				<select name="system.handedness" {{#unless editable}}disabled{{/unless}}>{{#each handednessOptions as |option|}}<option value="{{option.value}}" {{#if option.selected}}selected{{/if}}>{{option.label}}</option>{{/each}}</select>
			</label>
			<label class="combat-item-sheet__field"><span>{{ui.specialistSkillId}}</span><input type="text" name="system.specialistSkillId" value="{{system.specialistSkillId}}" autocomplete="off" {{#unless editable}}disabled{{/unless}}></label>
		</div>

		{{#unless isRanged}}
			<div class="combat-item-sheet__parry">
				<label class="combat-item-sheet__check wfrp1ed-checkbox"><input type="checkbox" name="system.parry.suitable" {{#if system.parry.suitable}}checked{{/if}} {{#unless editable}}disabled{{/unless}}><span>{{ui.parrySuitable}}</span></label>
				<label class="combat-item-sheet__field combat-item-sheet__field--compact"><span>{{ui.parryBonus}}</span><input type="number" step="1" name="system.parry.bonus" value="{{system.parry.bonus}}" {{#unless editable}}disabled{{/unless}}></label>
			</div>
		{{/unless}}
	</section>

	{{#if isRanged}}
		<section class="combat-item-sheet__panel">
			<h3>{{ui.rangedDetails}}</h3>
			<div class="combat-item-sheet__grid combat-item-sheet__grid--5">
				<label class="combat-item-sheet__field"><span>{{ui.shortRange}}</span><input type="text" inputmode="numeric" pattern="(?:-|[0-9]+)" name="system.range.short" value="{{system.range.short}}" {{#unless editable}}disabled{{/unless}}></label>
				<label class="combat-item-sheet__field"><span>{{ui.longRange}}</span><input type="text" inputmode="numeric" pattern="(?:-|[0-9]+)" name="system.range.long" value="{{system.range.long}}" {{#unless editable}}disabled{{/unless}}></label>
				<label class="combat-item-sheet__field"><span>{{ui.maximumRange}}</span><input type="text" inputmode="numeric" pattern="(?:-|[0-9]+)" name="system.range.max" value="{{system.range.max}}" {{#unless editable}}disabled{{/unless}}></label>
				<label class="combat-item-sheet__field"><span>{{ui.effectiveStrengthMode}}</span><select name="system.effectiveStrengthMode" {{#unless editable}}disabled{{/unless}}>{{#each effectiveStrengthModeOptions as |option|}}<option value="{{option.value}}" {{#if option.selected}}selected{{/if}}>{{option.label}}</option>{{/each}}</select></label>
				{{#unless usesCharacterStrength}}<label class="combat-item-sheet__field"><span>{{ui.effectiveStrength}}</span><input type="number" min="0" step="1" name="system.effectiveStrength" value="{{system.effectiveStrength}}" {{#unless editable}}disabled{{/unless}}></label>{{/unless}}
			</div>

			<div class="combat-item-sheet__grid combat-item-sheet__grid--2">
				<label class="combat-item-sheet__field">
					<span>{{ui.ammunitionType}}</span>
					<select name="system.ammunitionType" {{#unless editable}}disabled{{/unless}}>{{#each ammunitionTypeOptions as |option|}}<option value="{{option.value}}" {{#if option.selected}}selected{{/if}}>{{option.label}}</option>{{/each}}</select>
				</label>
				{{#if isCustomAmmunition}}
					<label class="combat-item-sheet__field"><span>{{ui.ammunitionCustomId}}</span><input type="text" name="system.ammunitionCustomId" value="{{system.ammunitionCustomId}}" autocomplete="off" {{#unless editable}}disabled{{/unless}}></label>
				{{/if}}
			</div>

			<div class="combat-item-sheet__panel-heading"><h3>{{ui.firingCycle}}</h3><p>{{ui.firingCycleHint}}</p></div>
			<div class="combat-item-sheet__grid combat-item-sheet__grid--4">
				<label class="combat-item-sheet__field"><span>{{ui.reloadRounds}}</span><input type="number" min="0" step="1" name="system.firingCycle.reloadRounds" value="{{system.firingCycle.reloadRounds}}" {{#unless editable}}disabled{{/unless}}></label>
				<label class="combat-item-sheet__field"><span>{{ui.shotsPerFireRound}}</span><input type="number" min="1" step="1" name="system.firingCycle.shotsPerFireRound" value="{{system.firingCycle.shotsPerFireRound}}" {{#unless editable}}disabled{{/unless}}></label>
				<label class="combat-item-sheet__field"><span>{{ui.magazineCapacity}}</span><input type="number" min="0" step="1" name="system.firingCycle.magazineCapacity" value="{{system.firingCycle.magazineCapacity}}" {{#unless editable}}disabled{{/unless}}></label>
				<label class="combat-item-sheet__field"><span>{{ui.magazineReloadRounds}}</span><input type="number" min="0" step="1" name="system.firingCycle.magazineReloadRounds" value="{{system.firingCycle.magazineReloadRounds}}" {{#unless editable}}disabled{{/unless}}></label>
			</div>
		</section>
	{{/if}}

	{{#unless isRanged}}
		<section class="combat-item-sheet__panel">
			<div class="combat-item-sheet__panel-heading"><h3>{{ui.optionalModifiers}}</h3><p>{{ui.optionalHint}}</p></div>
			<div class="combat-item-sheet__grid combat-item-sheet__grid--4">
				<label class="combat-item-sheet__field"><span>{{ui.initiative}}</span><input type="number" step="1" name="system.optionalModifiers.initiative" value="{{system.optionalModifiers.initiative}}" {{#unless editable}}disabled{{/unless}}></label>
				<label class="combat-item-sheet__field"><span>{{ui.toHit}}</span><input type="number" step="1" name="system.optionalModifiers.toHit" value="{{system.optionalModifiers.toHit}}" {{#unless editable}}disabled{{/unless}}></label>
				<label class="combat-item-sheet__field"><span>{{ui.damage}}</span><input type="number" step="1" name="system.optionalModifiers.damage" value="{{system.optionalModifiers.damage}}" {{#unless editable}}disabled{{/unless}}></label>
				<label class="combat-item-sheet__field"><span>{{ui.parryModifier}}</span><input type="number" step="1" name="system.optionalModifiers.parry" value="{{system.optionalModifiers.parry}}" {{#unless editable}}disabled{{/unless}}></label>
			</div>
		</section>
	{{/unless}}

			<label class="combat-item-sheet__field combat-item-sheet__description"><span>{{ui.description}}</span><textarea name="system.description" spellcheck="true" {{#unless editable}}disabled{{/unless}}>{{system.description}}</textarea></label>
		</section>

		<section class="equipment-effects-panel" data-weapon-tab-panel="effects" hidden>
			<header class="equipment-effects-panel__header">
				<div>
					<h3>{{ui.effectsTab}}</h3>
					<p>{{ui.effectsHint}}</p>
				</div>
				<button type="button" data-action="createEffect" {{#unless editable}}disabled{{/unless}}><i class="fa-solid fa-plus"></i> {{ui.addEffect}}</button>
			</header>
			<div class="equipment-effects-list">
				{{#each effects as |effect|}}
					<article class="equipment-effect-card {{#if effect.disabled}}is-disabled{{/if}}" data-effect-id="{{effect.id}}">
						<img src="{{effect.img}}" alt="">
						<div class="equipment-effect-card__identity"><strong>{{effect.name}}</strong><span>{{effect.stateLabel}}</span></div>
						<div class="equipment-effect-card__actions">
							<button type="button" data-action="toggleEffect" {{#unless ../editable}}disabled{{/unless}}><i class="fa-solid {{#if effect.disabled}}fa-toggle-off{{else}}fa-toggle-on{{/if}}"></i></button>
							<button type="button" data-action="configureEffect"><i class="fa-solid fa-gear"></i></button>
							<button type="button" data-action="deleteEffect" {{#unless ../editable}}disabled{{/unless}}><i class="fa-solid fa-trash"></i></button>
						</div>
					</article>
				{{else}}
					<p class="equipment-effects-panel__empty">{{ui.noEffects}}</p>
				{{/each}}
			</div>
		</section>
	</div>
</div>
