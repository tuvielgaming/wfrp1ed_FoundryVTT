<form class="{{cssClass}}" autocomplete="off">
	<header class="sheet-header">
		<img
			class="item-img"
			src="{{item.img}}"
			data-edit="img"
			title="{{item.name}}"
		/>
		<div class="header-fields">
			<h1 class="charname"><input
					name="name"
					type="text"
					value="{{item.name}}"
					placeholder="Name"
				/></h1>
			<div class="grid grid-2col">
				<div class="resource">
					<label class="resource-label">Quantity</label>
					<input
						type="text"
						name="system.quantity"
						value="{{system.quantity}}"
						data-dtype="Number"
					/>
				</div>
				<div class="resource">
					<label class="resource-label">Weight</label>
					<input
						type="text"
						name="system.weight"
						value="{{system.weight}}"
						data-dtype="Number"
					/>
				</div>
				<div id="player-characteristics">
					<table>
						<tr id="characterisitcs-labels">
							<th
								style="width: 25%; background-image: none; color: black;"
							></th>
							<th style="width: 5.0%">{{localize "WFRP1ed.CHARAbbrev.I"}}</th>
							<th style="width: 5.0%">{{localize "WFRP1ed.CHARAbbrev.WS"}}</th>
							<th style="width: 5.0%">{{localize "WFRP1ed.CHARAbbrev.Dmg"}}</th>
							<th style="width: 5.0%">{{localize
									"WFRP1ed.CHARAbbrev.Parry"
								}}</th>
						</tr>
						<tr>
							<td class="cell-label">{{localize
									"WFRP1ed.CHAR.Characteristic"
								}}</td>
							<td>
								<input
									name="system.characteristics.initiative"
									type="text"
									value="{{system.characteristics.initiative.value}}"
									data-dtype="Number"
									onblur="this.readOnly='true';"
									readonly="true"
									ondblclick="this.readOnly='';"
								/>
							</td>
							<td>
								<input
									name="system.characteristics.weaponSkill"
									type="text"
									value="{{system.characteristics.weaponSkill.value}}"
									data-dtype="Number"
									onblur="this.readOnly='true';"
									readonly="true"
									ondblclick="this.readOnly='';"
								/>
							</td>
							<td>
								<input
									name="system.characteristics.damage"
									type="text"
									value="{{system.characteristics.damage.value}}"
									data-dtype="Number"
									onblur="this.readOnly='true';"
									readonly="true"
									ondblclick="this.readOnly='';"
								/>
							</td>
							<td>
								<input
									name="system.characteristics.parry"
									type="text"
									value="{{system.characteristics.parry.value}}"
									data-dtype="Number"
									onblur="this.readOnly='true';"
									readonly="true"
									ondblclick="this.readOnly='';"
								/>
							</td>
						</tr>
					</table>
				</div>
			</div>
		</div>
	</header>

	{{! Sheet Tab Navigation }}
	<nav class="sheet-tabs tabs" data-group="primary">
		<a class="item" data-tab="description">Description</a>
		<a class="item" data-tab="attributes">Attributes</a>
	</nav>

	{{! Sheet Body }}
	<section class="sheet-body">

		{{! Description Tab }}
		<div class="tab" data-group="primary" data-tab="description">
			{{! To render inline rolls in a TinyMCE editor, you need to pass the parent actor's (if any) roll data to the rollData prop. }}
			{{editor
				system.description
				target="system.description"
				rollData=rollData
				button=true
				owner=owner
				editable=editable
			}}
		</div>

		{{! Attributes Tab }}
		<div class="tab attributes" data-group="primary" data-tab="attributes">
			{{! As you add new fields, add them in here! }}
			<div class="resource">
				<label class="resource-label">Roll Formula</label>
				<input
					type="text"
					name="system.formula"
					value="{{system.formula}}"
					data-dtype="String"
				/>
			</div>
		</div>
	</section>
</form>