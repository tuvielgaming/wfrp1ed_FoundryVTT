<section class="critical-wound-sheet__content">
  <header class="critical-wound-sheet__header">
    <img
      class="critical-wound-sheet__image"
      src="{{item.img}}"
      alt="{{item.name}}"
    />

    <input
      class="critical-wound-sheet__name"
      type="text"
      name="name"
      value="{{item.name}}"
      {{#unless editable}}disabled{{/unless}}
    />
  </header>

  <section class="critical-wound-sheet__facts">
    <label class="critical-wound-sheet__field">
      <span>{{ui.criticalValue}}</span>
      <input
        type="number"
        name="system.criticalValue"
        min="0"
        step="1"
        value="{{system.criticalValue}}"
        {{#unless editable}}disabled{{/unless}}
      />
    </label>

    <label class="critical-wound-sheet__field">
      <span>{{ui.hitLocation}}</span>
      <input
        type="text"
        name="system.hitLocation"
        value="{{system.hitLocation}}"
        {{#unless editable}}disabled{{/unless}}
      />
    </label>
  </section>

  <label class="critical-wound-sheet__description">
    <span>{{ui.description}}</span>
    <textarea
      name="system.description"
      rows="8"
      {{#if descriptionManagedByCore}}
        readonly
        title="WFRP 1e Core Rulebook"
      {{else}}
        {{#unless editable}}disabled{{/unless}}
      {{/if}}
    >{{description}}</textarea>
  </label>

  <details class="critical-wound-sheet__provenance">
    <summary>{{ui.provenance}}</summary>

    {{#if provenanceRows.length}}
      <dl>
        {{#each provenanceRows}}
          <div class="critical-wound-sheet__provenance-row">
            <dt>{{label}}</dt>
            <dd>{{value}}</dd>
          </div>
        {{/each}}
      </dl>
    {{else}}
      <p class="critical-wound-sheet__empty">{{ui.provenanceEmpty}}</p>
    {{/if}}
  </details>

  <section class="critical-wound-sheet__consequences">
    <div class="critical-wound-sheet__section-heading">
      <div>
        <h3>{{ui.consequences}}</h3>
        <p>{{ui.consequencesHint}}</p>
      </div>

      <label class="wfrp1ed-checkbox critical-wound-sheet__automation-toggle">
        <input
          type="checkbox"
          name="system.consequence.enabled"
          {{checked consequence.enabled}}
          {{#unless editable}}disabled{{/unless}}
        />
        <span>{{ui.automationEnabled}}</span>
      </label>
    </div>

    <section class="critical-wound-sheet__consequence-block critical-wound-sheet__consequence-block--characteristics">
      <div class="critical-wound-sheet__subheading">
        <strong>{{ui.characteristics}}</strong>
        {{#if editable}}
          <button
            type="button"
            data-action="addConsequenceCharacteristic"
          >
            <i class="fa-solid fa-plus" aria-hidden="true"></i>
            {{ui.addCharacteristic}}
          </button>
        {{/if}}
      </div>

      <div class="critical-wound-sheet__consequence-grid">
        <label class="critical-wound-sheet__field">
          <span>{{ui.durationFormula}}</span>
          <input
            type="text"
            name="system.consequence.duration.formula"
            value="{{consequence.duration.formula}}"
            placeholder="1d4"
            {{#unless editable}}disabled{{/unless}}
          />
        </label>

        <label class="critical-wound-sheet__field">
          <span>{{ui.durationUnits}}</span>
          <select
            name="system.consequence.duration.units"
            {{#unless editable}}disabled{{/unless}}
          >
            {{selectOptions ui.durationUnitOptions selected=consequence.duration.units localize=false}}
          </select>
        </label>

        <label class="critical-wound-sheet__field">
          <span>{{ui.until}}</span>
          <select
            name="system.consequence.duration.until"
            {{#unless editable}}disabled{{/unless}}
          >
            {{selectOptions ui.untilOptions selected=consequence.duration.until localize=false}}
          </select>
        </label>
      </div>

      {{#if consequence.characteristics.length}}
        <ol class="critical-wound-sheet__consequence-list">
          {{#each consequence.characteristics}}
            <li
              class="critical-wound-sheet__consequence-row"
              data-consequence-characteristic-index="{{@index}}"
            >
              <select
                data-consequence-characteristic-field="characteristicId"
                {{#unless ../editable}}disabled{{/unless}}
              >
                {{selectOptions ../ui.characteristicOptions selected=characteristicId localize=false}}
              </select>

              <select
                data-consequence-characteristic-field="operation"
                {{#unless ../editable}}disabled{{/unless}}
              >
                {{selectOptions ../ui.operationOptions selected=operation localize=false}}
              </select>

              <input
                type="number"
                step="any"
                value="{{value}}"
                data-consequence-characteristic-field="value"
                {{#unless ../editable}}disabled{{/unless}}
              />

              {{#if ../editable}}
                <button
                  type="button"
                  data-action="removeConsequenceCharacteristic"
                  title="{{../ui.removeCharacteristic}}"
                  aria-label="{{../ui.removeCharacteristic}}"
                >
                  <i class="fa-solid fa-trash" aria-hidden="true"></i>
                </button>
              {{/if}}
            </li>
          {{/each}}
        </ol>
      {{/if}}
    </section>

    <section class="critical-wound-sheet__consequence-block critical-wound-sheet__consequence-block--periodic">
      <div class="critical-wound-sheet__subheading">
        <strong>{{ui.periodicWounds}}</strong>
      </div>

      <div class="critical-wound-sheet__consequence-grid critical-wound-sheet__consequence-grid--periodic">
        <label class="critical-wound-sheet__field">
          <span>{{ui.periodicWounds}}</span>
          <input
            type="text"
            name="system.consequence.periodicWounds.formula"
            value="{{consequence.periodicWounds.formula}}"
            placeholder="1d4"
            {{#unless editable}}disabled{{/unless}}
          />
        </label>

        <label class="critical-wound-sheet__field">
          <span>{{ui.periodicDurationFormula}}</span>
          <input
            type="text"
            name="system.consequence.periodicWounds.duration.formula"
            value="{{consequence.periodicWounds.duration.formula}}"
            placeholder="2 or 1d4"
            {{#unless editable}}disabled{{/unless}}
          />
        </label>

        <label class="critical-wound-sheet__field">
          <span>{{ui.periodicDurationUnits}}</span>
          <select
            name="system.consequence.periodicWounds.duration.units"
            {{#unless editable}}disabled{{/unless}}
          >
            {{selectOptions ui.periodicDurationUnitOptions selected=consequence.periodicWounds.duration.units localize=false}}
          </select>
        </label>

        <label class="critical-wound-sheet__field">
          <span>{{ui.periodicUntil}}</span>
          <select
            name="system.consequence.periodicWounds.until"
            {{#unless editable}}disabled{{/unless}}
          >
            {{selectOptions ui.untilOptions selected=consequence.periodicWounds.until localize=false}}
          </select>
        </label>
      </div>
    </section>

    <section class="critical-wound-sheet__consequence-block critical-wound-sheet__consequence-block--drop-held">
      <div class="critical-wound-sheet__subheading">
        <strong>{{ui.dropHeld}}</strong>
      </div>

      <label class="critical-wound-sheet__field critical-wound-sheet__field--drop-held">
        <select
          name="system.consequence.dropHeld"
          aria-label="{{ui.dropHeld}}"
          {{#unless editable}}disabled{{/unless}}
        >
          {{selectOptions ui.dropHeldOptions selected=consequence.dropHeld localize=false}}
        </select>
      </label>
    </section>
  </section>

  <section class="critical-wound-sheet__effects">
    <div class="critical-wound-sheet__section-heading">
      <div>
        <h3>{{ui.effects}}</h3>
        <p>{{ui.effectsHint}}</p>
      </div>

      {{#if editable}}
        <button
          type="button"
          data-action="createEffect"
        >
          <i class="fa-solid fa-plus" aria-hidden="true"></i>
          {{ui.addEffect}}
        </button>
      {{/if}}
    </div>

    {{#if effects.length}}
      <ol class="critical-wound-sheet__effect-list">
        {{#each effects}}
          <li
            class="critical-wound-sheet__effect {{#if disabled}}is-disabled{{/if}}"
            data-effect-id="{{id}}"
          >
            <img src="{{img}}" alt="" />

            <div class="critical-wound-sheet__effect-main">
              <strong>{{name}}</strong>
              <span>{{stateLabel}}{{#if transfer}} · {{../ui.transfers}}{{/if}}</span>
            </div>

            <div class="critical-wound-sheet__effect-actions">
              <button
                type="button"
                data-action="configureEffect"
                title="{{../ui.configureEffect}}"
                aria-label="{{../ui.configureEffect}}"
              >
                <i class="fa-solid fa-gear" aria-hidden="true"></i>
              </button>

              {{#if ../editable}}
                <button
                  type="button"
                  data-action="toggleEffect"
                  title="{{toggleLabel}}"
                  aria-label="{{toggleLabel}}"
                >
                  <i class="fa-solid {{#if disabled}}fa-toggle-off{{else}}fa-toggle-on{{/if}}" aria-hidden="true"></i>
                </button>

                <button
                  type="button"
                  data-action="deleteEffect"
                  title="{{../ui.deleteEffect}}"
                  aria-label="{{../ui.deleteEffect}}"
                >
                  <i class="fa-solid fa-trash" aria-hidden="true"></i>
                </button>
              {{/if}}
            </div>
          </li>
        {{/each}}
      </ol>
    {{else}}
      <p class="critical-wound-sheet__empty">{{ui.noEffects}}</p>
    {{/if}}
  </section>
</section>
