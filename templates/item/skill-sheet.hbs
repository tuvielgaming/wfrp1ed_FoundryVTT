<section class="skill-sheet-content">
	<header class="skill-sheet-header wfrp1ed-item-header">
		<img
			class="skill-sheet-image wfrp1ed-item-header__image"
			data-wfrp1ed-item-image
			src="{{item.img}}"
			alt="{{item.name}}"
		>

		<div class="skill-sheet-field skill-sheet-field--name">
			<label for="skill-name-{{item.id}}">
				{{localize "WFRP1ED.SkillSheet.Name"}}
			</label>

			<input
				id="skill-name-{{item.id}}"
				type="text"
				name="name"
				value="{{item.name}}"
				autocomplete="off"
				required
				{{#unless editable}}disabled{{/unless}}
			>
		</div>
	</header>

	<div class="skill-sheet-field skill-sheet-field--rules-id">
		<label
			for="skill-rules-id-{{item.id}}"
			data-tooltip="{{localize 'WFRP1ED.SkillSheet.RulesIdHint'}}"
		>
			{{localize "WFRP1ED.SkillSheet.RulesId"}}
		</label>

		<select
			id="skill-rules-id-{{item.id}}"
			name="system.rulesId"
			{{#unless editable}}disabled{{/unless}}
		>
			{{#each rulesIdOptions as |option|}}
				<option
					value="{{option.value}}"
					{{#if option.selected}}selected{{/if}}
				>
					{{option.label}}
				</option>
			{{/each}}
		</select>
	</div>

	<div class="skill-sheet-field skill-sheet-field--specialisation">
		<label for="skill-specialisation-{{item.id}}">
			{{localize "WFRP1ED.SkillSheet.Specialisation"}}
		</label>

		<input
			id="skill-specialisation-{{item.id}}"
			type="text"
			name="system.specialisation"
			value="{{system.specialisation}}"
			autocomplete="off"
			{{#unless editable}}disabled{{/unless}}
		>
	</div>

	<div class="skill-sheet-field skill-sheet-field--description">
		<label for="skill-description-{{item.id}}">
			{{localize "WFRP1ED.SkillSheet.Description"}}
		</label>

		<textarea
			id="skill-description-{{item.id}}"
			name="system.description"
			spellcheck="true"
			{{#unless editable}}disabled{{/unless}}
		>{{system.description}}</textarea>
	</div>
</section>
