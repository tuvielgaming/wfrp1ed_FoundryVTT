<div class="career-book-page">
	<header class="career-book-header">
		<div class="career-title-rule" aria-hidden="true"></div>
		<div class="career-title-row">
			<span aria-hidden="true">•</span>
			<input
				type="text"
				name="name"
				value="{{item.name}}"
				class="career-title-input"
				{{#unless editable}}readonly{{/unless}}
			>
			<span aria-hidden="true">•</span>
		</div>
		<div class="career-title-rule" aria-hidden="true"></div>

		<div class="career-meta-row">
			<label class="career-meta-field">
				<span>{{careerUi.labels.class}}</span>
				<select name="system.class" {{#unless editable}}disabled{{/unless}}>
					{{#each careerUi.classOptions as |option|}}
						<option value="{{option.value}}" {{#if option.selected}}selected{{/if}}>{{option.label}}</option>
					{{/each}}
				</select>
			</label>
			<label class="career-meta-field">
				<span>{{careerUi.labels.tier}}</span>
				<select name="system.tier" {{#unless editable}}disabled{{/unless}}>
					{{#each careerUi.tierOptions as |option|}}
						<option value="{{option.value}}" {{#if option.selected}}selected{{/if}}>{{option.label}}</option>
					{{/each}}
				</select>
			</label>
			<div class="career-meta-magic">
				<span class="career-meta-magic__label">{{careerUi.labels.magicPoints}}</span>
				<div class="career-meta-magic__values">
					{{#each careerUi.magicPoints as |entry|}}
						<span class="career-magic-chip" title="{{entry.note}}">
							<strong>{{entry.formula}}</strong>
							<small>{{entry.raceLabel}}</small>
							{{#if @root.editable}}
								<button type="button" data-action="editMagicPoints" data-career-index="{{entry.index}}" title="Edit"><i class="fa-solid fa-pen"></i></button>
								<button type="button" data-action="deleteMagicPoints" data-career-index="{{entry.index}}" title="Delete"><i class="fa-solid fa-xmark"></i></button>
							{{/if}}
						</span>
					{{else}}
						<span class="career-meta-magic__empty">—</span>
					{{/each}}
					{{#if editable}}
						<button type="button" class="career-meta-magic__add" data-action="addMagicPoints" title="Add Magic Points"><i class="fa-solid fa-plus"></i></button>
					{{/if}}
				</div>
			</div>
		</div>
	</header>

	<div class="career-intro-grid">
		<section class="career-description-block">
			<textarea
				name="system.description"
				class="career-description"
				{{#unless editable}}readonly{{/unless}}
			>{{system.description}}</textarea>
		</section>

		<figure class="career-artwork-frame">
			<img
				class="career-item-sheet__image"
				src="{{item.img}}"
				alt="{{item.name}}"
				draggable="false"
			>
		</figure>
	</div>

	<section class="career-section career-advance-section">
		<h2>{{careerUi.labels.advanceScheme}}</h2>
		<table class="career-advance-table">
			<thead>
				<tr>
					{{#each careerUi.characteristics as |characteristic|}}
						<th>{{characteristic.label}}</th>
					{{/each}}
				</tr>
			</thead>
			<tbody>
				<tr>
					{{#each careerUi.characteristics as |characteristic|}}
						<td>
							{{#if @root.editable}}
								<input
									type="number"
									min="0"
									step="1"
									name="system.advanceScheme.{{characteristic.id}}"
									value="{{characteristic.steps}}"
									title="{{characteristic.display}}"
								>
								<span class="career-advance-preview">{{characteristic.display}}</span>
							{{else}}
								{{characteristic.display}}
							{{/if}}
						</td>
					{{/each}}
				</tr>
			</tbody>
		</table>
	</section>

	<section class="career-tab-workspace">
		<nav class="career-tab-nav" role="tablist" aria-label="Career details">
			<button type="button" role="tab" data-career-tab="skills">{{careerUi.labels.skills}}</button>
			<button type="button" role="tab" data-career-tab="trappings">{{careerUi.labels.trappings}}</button>
			<button type="button" role="tab" data-career-tab="exits">{{careerUi.labels.exits}}</button>
		</nav>

		<div class="career-tab-panels">
			<section class="career-tab-panel career-list-section" role="tabpanel" data-career-panel="skills" data-career-drop-zone="skills">
				<div class="career-tab-entry-grid">
					{{#each careerUi.skills as |entry|}}
						<div class="career-entry" data-career-drop-zone="skills" data-career-entry-id="{{entry.id}}">
							<div class="career-entry-text">
								{{#if entry.chanceLabel}}<strong>{{entry.chanceLabel}}</strong> {{/if}}
								<span>{{entry.display}}</span>
								{{#if entry.modeLabel}}<em>({{entry.modeLabel}})</em>{{/if}}
								{{#if entry.note}}<small>{{entry.note}}</small>{{/if}}
							</div>
							{{#if @root.editable}}
								<div class="career-entry-controls">
									<button type="button" data-action="configureEntry" data-career-collection="skills" data-career-entry-id="{{entry.id}}" title="Configure"><i class="fa-solid fa-gear"></i></button>
									<button type="button" data-action="deleteEntry" data-career-collection="skills" data-career-entry-id="{{entry.id}}" title="Delete"><i class="fa-solid fa-trash"></i></button>
								</div>
								<div class="career-choice-editor">
									{{#each entry.choices as |choice|}}
										<span
											class="career-choice-chip"
											data-career-drop-zone="skills"
											data-career-entry-id="{{../id}}"
											data-career-choice-id="{{choice.id}}"
											title="Drop another Skill here to add it to this same option"
										>
											{{choice.label}}
											<button type="button" data-action="deleteChoice" data-career-collection="skills" data-career-entry-id="{{../id}}" data-career-choice-id="{{choice.id}}" title="Delete alternative"><i class="fa-solid fa-xmark"></i></button>
										</span>
									{{/each}}
								</div>
							{{/if}}
						</div>
					{{else}}
						<p class="career-empty">—</p>
					{{/each}}
				</div>
				{{#if editable}}<div class="career-drop-hint">{{careerUi.labels.dropSkill}}</div>{{/if}}
			</section>

			<section class="career-tab-panel career-list-section" role="tabpanel" data-career-panel="trappings" data-career-drop-zone="trappings">
				<div class="career-tab-entry-grid">
					{{#each careerUi.trappings as |entry|}}
						<div class="career-entry" data-career-drop-zone="trappings" data-career-entry-id="{{entry.id}}">
							<div class="career-entry-text">
								{{#if entry.chanceLabel}}<strong>{{entry.chanceLabel}}</strong> {{/if}}
								<span>{{entry.display}}</span>
								{{#if entry.modeLabel}}<em>({{entry.modeLabel}})</em>{{/if}}
								{{#if entry.note}}<small>{{entry.note}}</small>{{/if}}
							</div>
							{{#if @root.editable}}
								<div class="career-entry-controls">
									<button type="button" data-action="configureEntry" data-career-collection="trappings" data-career-entry-id="{{entry.id}}" title="Configure"><i class="fa-solid fa-gear"></i></button>
									<button type="button" data-action="deleteEntry" data-career-collection="trappings" data-career-entry-id="{{entry.id}}" title="Delete"><i class="fa-solid fa-trash"></i></button>
								</div>
								<div class="career-choice-editor">
									{{#each entry.choices as |choice|}}
										<span
											class="career-choice-chip"
											data-career-drop-zone="trappings"
											data-career-entry-id="{{../id}}"
											data-career-choice-id="{{choice.id}}"
											title="Drop another Trapping here to add it to this same option"
										>
											{{choice.label}}
											<button type="button" data-action="deleteChoice" data-career-collection="trappings" data-career-entry-id="{{../id}}" data-career-choice-id="{{choice.id}}" title="Delete alternative"><i class="fa-solid fa-xmark"></i></button>
										</span>
									{{/each}}
								</div>
							{{/if}}
						</div>
					{{else}}
						<p class="career-empty">—</p>
					{{/each}}
				</div>
				{{#if editable}}<div class="career-drop-hint">{{careerUi.labels.dropTrapping}}</div>{{/if}}
			</section>

			<section class="career-tab-panel career-list-section career-exits-section" role="tabpanel" data-career-panel="exits" data-career-drop-zone="exits">
				<div class="career-tab-entry-grid">
					{{#each careerUi.exits as |exit|}}
						<div class="career-entry career-exit-entry">
							<div class="career-entry-text">
								<span>{{exit.displayName}}</span>
								{{#if exit.condition}}<small>{{exit.condition}}</small>{{/if}}
							</div>
							{{#if @root.editable}}
								<div class="career-entry-controls">
									<button type="button" data-action="deleteExit" data-career-index="{{exit.index}}"><i class="fa-solid fa-trash"></i></button>
								</div>
							{{/if}}
						</div>
					{{else}}
						<p class="career-empty">—</p>
					{{/each}}
				</div>
				{{#if editable}}<div class="career-drop-hint">{{careerUi.labels.dropExit}}</div>{{/if}}
			</section>
		</div>
	</section>
</div>