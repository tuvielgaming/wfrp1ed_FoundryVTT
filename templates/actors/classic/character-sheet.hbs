<section class="wfrp1ed-sheet wfrp1ed-classic-sheet">
	<div class="classic-sheet-pages">
		{{#each pages as |page|}}
			<section
				class="sheet-page classic-sheet-page"
				data-page="{{page.number}}"
				style="
					{{page.cssVariables}};
					position: relative;
					width: var(--page-width);
					height: var(--page-height);
					background-image: var(--page-background);
					background-repeat: no-repeat;
					background-position: top left;
					background-size: 100% 100%;
				"
			>
				{{#if page.sections.header}}
					<section
						class="sheet-overlay sheet-overlay--header"
						data-section="header"
						style="
							{{page.sections.header.cssVariables}};
							position: absolute;
							left: var(--section-x);
							top: var(--section-y);
							width: var(--section-width);
							height: var(--section-height);
						"
					>
						{{>
							"systems/wfrp1ed/templates/actors/classic/parts/header.hbs"
							@root
						}}
					</section>
				{{/if}}

				{{#if page.sections.characteristics}}
					<section
						class="sheet-overlay sheet-overlay--characteristics"
						data-section="characteristics"
						style="
							{{page.sections.characteristics.cssVariables}};
							position: absolute;
							left: var(--section-x);
							top: var(--section-y);
							width: var(--section-width);
							height: var(--section-height);
						"
					>
						{{>
							"systems/wfrp1ed/templates/actors/classic/parts/characteristics.hbs"
							@root
						}}
					</section>
				{{/if}}

				{{#if page.sections.melee}}
					<section
						class="sheet-overlay sheet-overlay--melee"
						data-section="melee"
						style="
							{{page.sections.melee.cssVariables}};
							position: absolute;
							left: var(--section-x);
							top: var(--section-y);
							width: var(--section-width);
							height: var(--section-height);
						"
					>
						{{>
							"systems/wfrp1ed/templates/actors/classic/parts/melee.hbs"
							@root
						}}
					</section>
				{{/if}}

				{{#if page.sections.ranged}}
					<section
						class="sheet-overlay sheet-overlay--ranged"
						data-section="ranged"
						style="
							{{page.sections.ranged.cssVariables}};
							position: absolute;
							left: var(--section-x);
							top: var(--section-y);
							width: var(--section-width);
							height: var(--section-height);
						"
					>
						{{>
							"systems/wfrp1ed/templates/actors/classic/parts/ranged.hbs"
							@root
						}}
					</section>
				{{/if}}

				{{#if page.sections.armour}}
					<section
						class="sheet-overlay sheet-overlay--armour"
						data-section="armour"
						style="
							{{page.sections.armour.cssVariables}};
							position: absolute;
							left: var(--section-x);
							top: var(--section-y);
							width: var(--section-width);
							height: var(--section-height);
						"
					>
						{{>
							"systems/wfrp1ed/templates/actors/classic/parts/armour.hbs"
							@root
						}}
					</section>
				{{/if}}

				{{#if page.sections.skillsPrimary}}
					<section
						class="sheet-overlay sheet-overlay--skills-primary"
						data-section="skillsPrimary"
						style="
							{{page.sections.skillsPrimary.cssVariables}};
							position: absolute;
							left: var(--section-x);
							top: var(--section-y);
							width: var(--section-width);
							height: var(--section-height);
						"
					>
						{{>
							"systems/wfrp1ed/templates/actors/classic/parts/skills-primary.hbs"
							@root
						}}
					</section>
				{{/if}}

				{{#if page.sections.armourPoints}}
					<section
						class="sheet-overlay sheet-overlay--armour-points"
						data-section="armourPoints"
						style="
							{{page.sections.armourPoints.cssVariables}};
							position: absolute;
							left: var(--section-x);
							top: var(--section-y);
							width: var(--section-width);
							height: var(--section-height);
						"
					>
						{{>
							"systems/wfrp1ed/templates/actors/classic/parts/armour-points.hbs"
							@root
						}}
					</section>
				{{/if}}

				{{#if page.sections.skillsSecondary}}
					<section
						class="sheet-overlay sheet-overlay--skills-secondary"
						data-section="skillsSecondary"
						style="
							{{page.sections.skillsSecondary.cssVariables}};
							position: absolute;
							left: var(--section-x);
							top: var(--section-y);
							width: var(--section-width);
							height: var(--section-height);
						"
					>
						{{>
							"systems/wfrp1ed/templates/actors/classic/parts/skills-secondary.hbs"
							@root
						}}
					</section>
				{{/if}}

				{{#if page.sections.equipment}}
					<section
						class="sheet-overlay sheet-overlay--equipment"
						data-section="equipment"
						style="
							{{page.sections.equipment.cssVariables}};
							position: absolute;
							left: var(--section-x);
							top: var(--section-y);
							width: var(--section-width);
							height: var(--section-height);
						"
					>
						{{>
							"systems/wfrp1ed/templates/actors/classic/parts/equipment.hbs"
							@root
						}}
					</section>
				{{/if}}

				{{#if page.sections.wealth}}
					<section
						class="sheet-overlay sheet-overlay--wealth"
						data-section="wealth"
						style="
							{{page.sections.wealth.cssVariables}};
							position: absolute;
							left: var(--section-x);
							top: var(--section-y);
							width: var(--section-width);
							height: var(--section-height);
						"
					>
						{{>
							"systems/wfrp1ed/templates/actors/classic/parts/wealth.hbs"
							@root
						}}
					</section>
				{{/if}}

				{{#if page.sections.psychology}}
					<section
						class="sheet-overlay sheet-overlay--psychology"
						data-section="psychology"
						style="
							{{page.sections.psychology.cssVariables}};
							position: absolute;
							left: var(--section-x);
							top: var(--section-y);
							width: var(--section-width);
							height: var(--section-height);
						"
					>
						<div class="classic-health-categories">
							<button
								type="button"
								class="classic-health-category"
								data-wfrp1ed-health-category="criticalWound"
							>
								<i class="fas fa-heart-crack" aria-hidden="true"></i>
								<span
									class="classic-health-category__label"
									data-health-category-label
								></span>
								<span
									class="classic-health-category__count"
									data-health-category-count
									hidden
								></span>
							</button>
						</div>
					</section>
				{{/if}}

				{{#if page.sections.spells}}
					<section
						class="sheet-overlay sheet-overlay--spells"
						data-section="spells"
						style="
							{{page.sections.spells.cssVariables}};
							position: absolute;
							left: var(--section-x);
							top: var(--section-y);
							width: var(--section-width);
							height: var(--section-height);
						"
					>
						{{>
							"systems/wfrp1ed/templates/actors/classic/parts/spells.hbs"
							@root
						}}
					</section>
				{{/if}}

				{{#if page.sections.magicPoints}}
					<section
						class="sheet-overlay sheet-overlay--magic-points"
						data-section="magicPoints"
						style="{{page.sections.magicPoints.cssVariables}}; position: absolute; left: var(--section-x); top: var(--section-y); width: var(--section-width); height: var(--section-height);"
					>
						<input class="classic-magic-resource" type="number" name="system.status.magicPoints" value="{{display.status.magicPoints}}" min="0" step="1" aria-label="Punkty Magii" {{#unless editable}}disabled{{/unless}}>
					</section>
				{{/if}}

				{{#if page.sections.powerLevel}}
					<section
						class="sheet-overlay sheet-overlay--power-level"
						data-section="powerLevel"
						style="{{page.sections.powerLevel.cssVariables}}; position: absolute; left: var(--section-x); top: var(--section-y); width: var(--section-width); height: var(--section-height);"
					>
						<input class="classic-magic-resource" type="number" name="system.status.powerLevel" value="{{display.status.powerLevel}}" min="0" step="1" aria-label="Poziom Mocy" {{#unless editable}}disabled{{/unless}}>
					</section>
				{{/if}}

				{{#if page.sections.fate}}
					<section
						class="sheet-overlay sheet-overlay--fate"
						data-section="fate"
						style="
							{{page.sections.fate.cssVariables}};
							position: absolute;
							left: var(--section-x);
							top: var(--section-y);
							width: var(--section-width);
							height: var(--section-height);
						"
					>
						{{>
							"systems/wfrp1ed/templates/actors/classic/parts/fate.hbs"
							@root
						}}
					</section>
				{{/if}}
			</section>
		{{/each}}
	</div>
</section>
