<section class="sheet-block skills skills--primary">
	{{#if editable}}
		<button
			type="button"
			class="skill-control skill-control--add"
			data-action="addSkill"
			aria-label="{{localize 'WFRP1ED.SkillSheet.AddSkill'}}"
			data-tooltip="{{localize 'WFRP1ED.SkillSheet.AddSkill'}}"
		>
			<i class="fa-solid fa-plus" aria-hidden="true"></i>
		</button>
	{{/if}}

	<ol
		class="skills-list skills-list--primary"
		role="list"
	>
		<li class="skill-row standard-test-row">
			<button
				type="button"
				class="skill-name standard-test-launcher"
				data-action="standardTest"
				aria-label="{{localize 'WFRP1ED.StandardTest.Launcher'}}"
				data-tooltip="{{localize 'WFRP1ED.StandardTest.Launcher'}}"
			>
				<span>{{localize "WFRP1ED.StandardTest.Launcher"}}</span>
			</button>
		</li>

		{{#each display.skills as |skill|}}
			{{#if skill.careerOffer}}
				<li class="skill-row skill-row--career-offer">
					<button
						type="button"
						class="skill-name skill-name--career-offer"
						data-career-skill-offer="{{skill.careerOfferKey}}"
						aria-label="{{skill.displayName}} — {{skill.cost}} PD"
						title="{{skill.careerName}} — {{skill.cost}} PD"
					>
						{{skill.displayName}}
					</button>
				</li>
			{{else}}
				{{#if (wfrp1edSkillAcquisitionVisible @root.display.actor.uuid skill.id)}}
					<li
						class="skill-row"
						data-item-id="{{skill.id}}"
						data-item-uuid="{{skill.uuid}}"
					>
						<button
							type="button"
							class="skill-name skill-name--open"
							data-action="openSkill"
							data-item-id="{{skill.id}}"
							aria-label="{{localize 'WFRP1ED.SkillSheet.OpenSkill'}}: {{wfrp1edSkillAcquisitionDisplayName @root.display.actor.uuid skill.id skill.displayName}}"
						>
							{{wfrp1edSkillAcquisitionDisplayName @root.display.actor.uuid skill.id skill.displayName}}
						</button>

						{{#if @root.editable}}
							<button
								type="button"
								class="skill-control skill-control--remove"
								data-action="removeSkill"
								data-item-id="{{skill.id}}"
								aria-label="{{localize 'WFRP1ED.SkillSheet.RemoveSkill'}}: {{wfrp1edSkillAcquisitionDisplayName @root.display.actor.uuid skill.id skill.displayName}}"
								data-tooltip="{{localize 'WFRP1ED.SkillSheet.RemoveSkill'}}"
							>
								<i class="fa-solid fa-trash" aria-hidden="true"></i>
							</button>
						{{/if}}
					</li>
				{{/if}}
			{{/if}}
		{{/each}}
	</ol>
</section>