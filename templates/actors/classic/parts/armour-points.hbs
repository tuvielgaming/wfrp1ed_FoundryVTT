<section
	class="sheet-block armour-points"
	aria-label="{{localize 'WFRP1ED.ArmourPointsLabel'}}"
>
	<label class="armour-points-field armour-points-field--head">
		<span class="visually-hidden">
			{{localize "WFRP1ED.ArmourPoints.Head"}}
		</span>

		<input
			type="number"
			name="system.status.armourPoints.head"
			value="{{display.armourPoints.head}}"
			min="0"
			step="1"
			inputmode="numeric"
			aria-label="{{localize 'WFRP1ED.ArmourPoints.Head'}}"
		/>
	</label>

	<label class="armour-points-field armour-points-field--shield">
		<input
			type="number"
			value="0"
			min="0"
			step="1"
			inputmode="numeric"
			readonly
			aria-label="{{localize 'WFRP1ED.ArmourPointsLabel'}}"
		/>
	</label>

	<label class="armour-points-field armour-points-field--right-arm">
		<span class="visually-hidden">
			{{localize "WFRP1ED.ArmourPoints.RightArm"}}
		</span>

		<input
			type="number"
			name="system.status.armourPoints.rightArm"
			value="{{display.armourPoints.rightArm}}"
			min="0"
			step="1"
			inputmode="numeric"
			aria-label="{{localize 'WFRP1ED.ArmourPoints.RightArm'}}"
		/>
	</label>

	<label class="armour-points-field armour-points-field--left-arm">
		<span class="visually-hidden">
			{{localize "WFRP1ED.ArmourPoints.LeftArm"}}
		</span>

		<input
			type="number"
			name="system.status.armourPoints.leftArm"
			value="{{display.armourPoints.leftArm}}"
			min="0"
			step="1"
			inputmode="numeric"
			aria-label="{{localize 'WFRP1ED.ArmourPoints.LeftArm'}}"
		/>
	</label>

	<label class="armour-points-field armour-points-field--body">
		<span class="visually-hidden">
			{{localize "WFRP1ED.ArmourPoints.Body"}}
		</span>

		<input
			type="number"
			name="system.status.armourPoints.body"
			value="{{display.armourPoints.body}}"
			min="0"
			step="1"
			inputmode="numeric"
			aria-label="{{localize 'WFRP1ED.ArmourPoints.Body'}}"
		/>
	</label>

	<label class="armour-points-field armour-points-field--right-leg">
		<span class="visually-hidden">
			{{localize "WFRP1ED.ArmourPoints.RightLeg"}}
		</span>

		<input
			type="number"
			name="system.status.armourPoints.rightLeg"
			value="{{display.armourPoints.rightLeg}}"
			min="0"
			step="1"
			inputmode="numeric"
			aria-label="{{localize 'WFRP1ED.ArmourPoints.RightLeg'}}"
		/>
	</label>

	<label class="armour-points-field armour-points-field--left-leg">
		<span class="visually-hidden">
			{{localize "WFRP1ED.ArmourPoints.LeftLeg"}}
		</span>

		<input
			type="number"
			name="system.status.armourPoints.leftLeg"
			value="{{display.armourPoints.leftLeg}}"
			min="0"
			step="1"
			inputmode="numeric"
			aria-label="{{localize 'WFRP1ED.ArmourPoints.LeftLeg'}}"
		/>
	</label>
</section>
