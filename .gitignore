# ============================================================
# WFRP 1e Foundry VTT - Git Ignore
# ============================================================


# ------------------------------------------------------------
# IDE / Editors
# ------------------------------------------------------------

.idea/
.vs/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

*.code-workspace
*.sublime-workspace

.project
.classpath
.settings/
.c9/
*.launch

/.vim


# ------------------------------------------------------------
# Operating System
# ------------------------------------------------------------

.DS_Store
Thumbs.db


# ------------------------------------------------------------
# Node / NPM
# ------------------------------------------------------------

node_modules/
jspm_packages/

.npm/
.eslintcache
.nyc_output/
coverage/

npm-debug.log*
yarn-debug.log*
yarn-error.log*

.yarn-integrity

*.tgz


# ------------------------------------------------------------
# Environment / Local Configuration
# ------------------------------------------------------------

.env
.env.*
!.env.example

foundryconfig.json
jsconfig.json


# ------------------------------------------------------------
# Generated Build Output
# ------------------------------------------------------------

dist/
tmp/
out/
out-tsc/
target/
build/

public/packs/
public/lang/
public/help/

.pack-build/


# ------------------------------------------------------------
# Foundry Compendium databases
#
# IMPORTANT:
# Compendium source belongs in module/core/.
# packs/ is generated by:
#
#     npm run build:packs
#
# Foundry/LevelDB can modify LOG, LOCK, CURRENT, MANIFEST and
# *.ldb files merely by opening the packs, so generated databases
# must not be version-controlled.
# ------------------------------------------------------------

/packs/


# ------------------------------------------------------------
# Runtime / Logs
# ------------------------------------------------------------

pids/
*.pid
*.seed
*.pid.lock

logs/
Logs/
*.log


# ------------------------------------------------------------
# Foundry Runtime Data
# ------------------------------------------------------------

/Data/assets/images/ddb-importer/
/Data/worlds/**/scenes/thumbs/


# ------------------------------------------------------------
# Local Foundry TLS configuration
# ------------------------------------------------------------

/Config/privkey.pem
/Config/fullchain.pem


# ------------------------------------------------------------
# Test / Tool Generated Files
# ------------------------------------------------------------

/test-scripts/
out.json

.sass-cache/
connect.lock
typings/

.grunt/


# ------------------------------------------------------------
# Optional local documentation output
# ------------------------------------------------------------

/docs/output/


# ------------------------------------------------------------
# Legacy / miscellaneous development tooling
# ------------------------------------------------------------

composer.lock
phpunit.xml
phpunit-dama-doctrine.xml

/vendor/
/bin/tools/*/vendor/

/.php-cs-fixer.cache
/.phpunit.result.cache

/tests/Fixtures/tmp/
/var/

/docker/.makefile